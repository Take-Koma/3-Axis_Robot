END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ipResultMessage:=_ipResultMessage;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="lrGrossWeight" Id="{f824e025-1bda-49e5-a5ca-e69403dda2db}">
      <Declaration><![CDATA[PROPERTY lrGrossWeight : LREAL]]></Declaration>
      <Get Name="Get" Id="{cd61a536-fecb-4fa0-a7f1-dca8495e7368}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[lrGrossWeight:=_lrGrossWeight;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="lrNetWeight" Id="{fbdaf916-8d7c-4fff-b77c-aade704d2ae5}">
      <Declaration><![CDATA[PROPERTY lrNetWeight : LREAL]]></Declaration>
      <Get Name="Get" Id="{da587d38-6424-4fa4-9a8a-ad81e16218e7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[lrNetWeight:=_lrNetWeight;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="lrTareWeight" Id="{2d6b0994-246a-4377-b31d-64c538440459}">
      <Declaration><![CDATA[PROPERTY lrTareWeight : LREAL]]></Declaration>
      <Get Name="Get" Id="{9605e312-e37e-4a9c-b94b-9fbc2634d1af}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[lrTareWeight:=_lrTareWeight;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="lrZAxisSetAcc" Id="{35dc73a5-21ab-4cbb-82f5-0b36d1561233}">
      <Declaration><![CDATA[PROPERTY lrZAxisSetAcc : LREAL]]></Declaration>
      <Set Name="Set" Id="{5b81915a-936d-45bd-a994-9343a2142edf}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_lrZAxisSetAcc:=lrZAxisSetAcc;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Reconfigure" Id="{024d9474-a773-4548-b0c3-9a9413c1073e}">
      <Declaration><![CDATA[METHOD Reconfigure
VAR_INPUT
	bReconfigureExe			:REFERENCE TO BOOL;	

  	stParamsComboFilter		:ST_WG_ComboFilter;
	stParamsScale			:ST_WG_Scaling;
  	stParamsWeighing		:ST_WG_Weighing;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bReconfigureExe THEN

	_stParamsComboFilter	:=stParamsComboFilter;
	_stParamsScale			:=stParamsScale;
	_stParamsWeighing		:=stParamsWeighing;
	
	IF NOT fbComboFilter.Configure(stConfig:=_stParamsComboFilter) THEN
		SetError(fbComboFilter);
	ELSIF NOT fbScale.Configure(stConfig:=_stParamsScale) THEN
		SetError(fbScale);
	ELSIF NOT fbWeighing.Configure(stConfig:=_stParamsWeighing) THEN
		SetError(fbWeighing);
	END_IF
	
	bReconfigureExe:=FALSE;
	
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetError" Id="{505b0742-9aaf-4cd9-b34c-4a783691ae12}">
      <Declaration><![CDATA[METHOD INTERNAL SetError : BOOL
VAR_INPUT
	fb : REFERENCE TO _FB_WG_BasicImplementationAlgorithm;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._bError := fb.bError;
THIS^._ipResultMessage := fb.ipResultMessage;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SpanCalibration" Id="{1fee681a-f68b-4846-be79-ced59a079654}">
      <Declaration><![CDATA[METHOD SpanCalibration
VAR_INPUT
	bSpanCalibrationExe		:REFERENCE TO BOOL;	
	lrCalibrationWeight		:LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ZeroCalibration" Id="{d9b77107-e635-4cec-af50-821abec08df5}">
      <Declaration><![CDATA[METHOD ZeroCalibration
VAR_INPUT
	bZeroCalibrationExe		:REFERENCE TO BOOL;	
END_VAR
	
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bZeroCalibrationExe AND_THEN NOT fbScale.Tare(nNumTareSamples) THEN
	SetError(fbScale);
	bZeroCalibrationExe:=FALSE;
ELSIF bZeroCalibrationExe THEN
	bZeroCalibrationExe:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
