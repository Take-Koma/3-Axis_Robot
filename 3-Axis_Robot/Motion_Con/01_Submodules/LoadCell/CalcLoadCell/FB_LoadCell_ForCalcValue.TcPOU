<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_LoadCell_ForCalcValue" Id="{d9f382fb-d7be-402c-819f-8abf17c52f28}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LoadCell_ForCalcValue IMPLEMENTS I_LoadCell
VAR
	rRMBValueInput			AT %I*	:REAL;													//EtherCATターミナルからの入力
	tTimestamp				AT %I*	:T_DCTIME64;											//EtherCATターミナルからのTimestamp
	_rEexcitationVoltage	AT %Q*	:REAL;													//ロードセル印加電圧 [V] 							
	bSampleMode				AT %Q*	:BOOL	:=TRUE;											//EL3356-0010のConversion mode 0=7.2ms 1=0.72ms latency
	bCalibrationInProgress	AT %I*	:BOOL;													//EL3356-0010のセルフキャリブレーション実行中

	_lrTareWeight					:LREAL;													//風袋重量[g]
	_lrCalibrationWeight			:LREAL;													//校正重量[g]		
	_lrGrossWeight					:LREAL;													//測定重量[g]
	_lrNetWeight					:LREAL;													//正味重量[g]
	
	_lrZAxisSetAcc					:LREAL;													//Z軸の設定加速度[mm/s2]
	i								:INT;													//演算用
	
	nNumTareSamples					:UDINT	:=100;											//風袋引きサンプル数

	_bError							:BOOL;
	_ipResultMessage				:I_TCMessage;

	// --- TF3685：設定構造体 ---
    _stParamsComboFilter			:ST_WG_ComboFilter;
	_stParamsScale					:ST_WG_Scaling;
  	_stParamsWeighing				:ST_WG_Weighing;
	
	// --- TF3685：FBインスタンス ---
	fbComboFilter 					:FB_WG_ComboFilter;
	fbScale 						:FB_WG_Scaling;
	fbWeighing						:FB_WG_Weighing;

	//-----中間の変数-----
	lrInput							:LREAL;
	lrOutFilter						:LREAL;
	lrOutScaling					:LREAL;



	//履歴バッファ タスク0.5msで150msまで保存
    alrAccHistory    				:ARRAY[0..300] OF LREAL;								//加速度指令値(Set値)
    anTimeHistory					:ARRAY[0..300] OF T_DCTIME64;							//DC時刻(Timestamp)
	
    tDelayOffset     				:T_DCTIME64 := 126*1000000;								//ScopeのTime Markerで測った遅延時間
    _lrGripperWeight				:LREAL;													//グリッパー重量[g]
    
    // --- 計算の過程で使う一時的な変数 ---
	tSearchTime      : T_DCTIME64;              // 「今」から108ms遡った「ターゲットとなる過去の時刻」
	lrTargetAcc      : LREAL;                // 検索で見つけ出した「108ms前の加速度」
	lrCompValue      : LREAL;                // 計算された慣性力（引くべき重さの変動分）
	fCorrectedWeight : LREAL;                // 【最終出力】揺れを打ち消した後の真の重量
	
	fFraction        : LREAL;                // 107.6msなど、ステップ間(0.5ms)の隙間を埋めるための比率
	tDiff            : LREAL;                // 記録されているデータ点同士の時間間隔
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="bError" Id="{0cdc9bc5-aa8f-42a0-ae11-5ca9c897b478}">
      <Declaration><![CDATA[PROPERTY bError : BOOL]]></Declaration>
      <Get Name="Get" Id="{ef05628c-fc54-42ac-8db2-7543f2d86856}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bError:=_bError;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Execute" Id="{811b902e-43b5-48d8-9a70-0e968cff8140}">
      <Declaration><![CDATA[METHOD Execute]]></Declaration>
      <Implementation>
        <ST><![CDATA[//------EtherCATターミナルからの読み出しデータ中間変数へ------
	lrInput:=REAL_TO_LREAL(rRMBValueInput);

//------TF3685のライブラリーで計算------
	IF NOT fbComboFilter.Call(ADR(lrInput), SIZEOF(lrInput), ADR(lrOutFilter), SIZEOF(lrOutFilter)) THEN
		SetError(fbComboFilter);
	END_IF
	
	IF NOT fbScale.Call(ADR(lrOutFilter), SIZEOF(lrOutFilter), ADR(lrOutScaling), SIZEOF(lrOutScaling)) THEN
		SetError(fbScale);
	END_IF
	
	IF NOT fbWeighing.Call(ADR(lrOutScaling), SIZEOF(lrOutScaling)) THEN
		SetError(fbWeighing);
	END_IF

//------履歴の更新------
	//最新データを配列の先頭に入れ、古いものを1つずつ押し出す
	FOR i := 300 TO 1 BY -1 DO
		alrAccHistory[i]:=alrAccHistory[i-1];
		anTimeHistory[i]:=anTimeHistory[i-1];
	END_FOR

	// 配列の[0]に最新の値を格納
	alrAccHistory[0]:=_lrZAxisSetAcc/1000;
	anTimeHistory[0]:=F_GetActualDcTime64();

//------108ms前の加速度をピンポイントで特定する------
	// 「今の時間」から「108ms」を引き算して、探すべき時間を決める
	tSearchTime := anTimeHistory[0] - tDelayOffset; 
	lrTargetAcc := 0;

	FOR i := 1 TO 300 DO
		// 配列の中で、ターゲットの時間を「またいでいる」2点（i番目とi-1番目）を探す
		IF anTimeHistory[i] <= tSearchTime AND anTimeHistory[i-1] > tSearchTime THEN
			
			// その2点間の実際の時間差（通常は周期の0.5msになるはず）
			tDiff := TO_LREAL(anTimeHistory[i-1] - anTimeHistory[i]);
			
			IF tDiff > 0 THEN
				// ターゲット時刻が、その2点間のどこに位置するかを0.0〜1.0で算出（線形補間）
				// 例：107.5ms(i) と 108.0ms(i-1) の間にある 107.6ms を探すため
				fFraction := TO_LREAL(tSearchTime - anTimeHistory[i]) / tDiff;
				
				// 2点の加速度データから、比率(fFraction)を使って間の値を計算
				lrTargetAcc := alrAccHistory[i] + fFraction * (alrAccHistory[i-1] - alrAccHistory[i]);
			ELSE
				// 万が一時間差が取れない場合は、古い方の値を採用
				lrTargetAcc := alrAccHistory[i];
			END_IF
			EXIT; // 見つかったのでループを抜ける
		END_IF
	END_FOR

// ============================================================
// 3. 慣性力の計算と引き算（ここが物理の法則）
// ============================================================
// 物理式：F = m * a  (力 = 質量 * 加速度)
// 単位を合わせるため、標準重力加速度 9.80665 で割って「g」に換算
lrCompValue := (_lrGripperWeight * lrTargetAcc / 9.80665);

// TF3685で綺麗にフィルタリングされた後の重量値から、108ms前の慣性力を引く
fCorrectedWeight := fbWeighing.fWeight + lrCompValue;


//------各重量を計算------
	//グロスウェイト計算
	_lrGrossWeight:=lrOutFilter;

	//風袋重量計算
	_lrTareWeight:=fbScale.fCurrentTareOffset;
	
	//ネットウェイト計算
	_lrNetWeight:=fbWeighing.fWeight;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{25b1a6de-6cdf-457e-97db-d529f24d199c}">
      <Declaration><![CDATA[//FB_Init は常に暗黙的に使用可能で、主に初期化に使用されます。
//戻り値は評価されません。特定の結果を得るために、メソッドを明示的に宣言し、
//そのメソッドに標準の初期化コードをもったコードを追加することができます。戻り値を評価できます。
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: 保持変数は初期化されます (ウォーム リセット、あるいはコールド リセット)
    bInCopyCode: BOOL;  // TRUE: 後でコードをコピーする (オンライン変更) ために、インスタンスをコピーします。
	
  	stParamsComboFilter		:ST_WG_ComboFilter;
	stParamsScale			:ST_WG_Scaling;
  	stParamsWeighing		:ST_WG_Weighing;
	
	rEexcitationVoltage		:REAL;
	
	lrGripperWeight			:LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bInCopyCode = FALSE THEN

	_stParamsComboFilter	:=stParamsComboFilter;
	_stParamsScale			:=stParamsScale;
	_stParamsWeighing		:=stParamsWeighing;
	
	IF NOT fbComboFilter.Configure(stConfig:=_stParamsComboFilter) THEN
		SetError(fbComboFilter);
	ELSIF NOT fbScale.Configure(stConfig:=_stParamsScale) THEN
		SetError(fbScale);
	ELSIF NOT fbWeighing.Configure(stConfig:=_stParamsWeighing) THEN
		SetError(fbWeighing);
	END_IF

	_rEexcitationVoltage:=rEexcitationVoltage;

	_lrGripperWeight:=lrGripperWeight;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ipResultMessage" Id="{2f5515d7-f549-48e0-bed5-d5048eaba2c2}">
      <Declaration><![CDATA[PROPERTY ipResultMessage : I_TcMessage]]></Declaration>
